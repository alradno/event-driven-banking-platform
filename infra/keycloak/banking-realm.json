{
  "realm": "banking",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {"name": "CUSTOMER"},
      {"name": "SUPPORT_AGENT"},
      {"name": "BACKOFFICE_OPERATOR"},
      {"name": "AUDITOR"},
      {"name": "SRE"},
      {"name": "ADMIN"}
    ]
  },
  "clients": [
    {
      "clientId": "banking-gateway",
      "name": "Banking Gateway",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Martin",
      "attributes": {"customer_id": ["11111111-1111-1111-1111-111111111111"]},
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Keller",
      "attributes": {"customer_id": ["22222222-2222-2222-2222-222222222222"]},
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "support",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["SUPPORT_AGENT"]
    },
    {
      "username": "auditor",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["AUDITOR"]
    },
    {
      "username": "sre",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["SRE"]
    },
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["ADMIN", "SRE", "AUDITOR"]
    }
  ]
}
